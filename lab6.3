import random

rows = 4
cols = 13
total_elements = rows * cols  # 52 элемента

#Генерируем список чисел от 1 до 52 и перемешиваем их
numbers = list(range(1, total_elements + 1))
random.shuffle(numbers)

# аполняем матрицу берём числа из перемешанного списка
matrix = []
index = 0
for _ in range(rows):
    row = numbers[index:index + cols]
    matrix.append(row)
    index += cols

# --- Вывод результатов в файл output.txt ---
with open('output5.txt', 'w', encoding='utf-8') as f:
    for row in matrix:
        #Каждое число занимает 3 символа для ровного столбца
        line = " ".join(f"{num:3}" for num in row)
        f.write(line + '\n')

print("Матрица успешно записана в output5.txt")
