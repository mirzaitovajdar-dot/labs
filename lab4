n = int(input("Введите количество точек n: "))

coords = []
print("Введите координаты точек через пробел (x1 y1 x2 y2 ...):")
coords = list(map(float, input().split()))

if len(coords) != 2 * n:
    print("Ошибка: должно быть введено", 2 * n, "чисел.")
else:
    #список точек (x, y)
    points = [(coords[i], coords[i + 1]) for i in range(0, 2 * n, 2)]

    #максимальное расстояние между ближайшими точками
    max_dist = -1
    pair = None
    for i in range(n - 1):
        dx = points[i + 1][0] - points[i][0]
        dy = points[i + 1][1] - points[i][1]
        dist = (dx ** 2 + dy ** 2) ** 0.5
        if dist > max_dist:
            max_dist = dist
            pair = (points[i], points[i + 1])

    print("Максимальное расстояние между соседними точками:", max_dist)
    print("Между точками:", pair)

    #точки попадающие в круг с центром x0, y0 и радиусом r
    x0 = float(input("Введите x0: "))
    y0 = float(input("Введите y0: "))
    r = float(input("Введите r: "))

    in_circle = [(x, y) for x, y in points if (x - x0) ** 2 + (y - y0) ** 2 <= r ** 2]

    #упорядочиваем точки по возрастанию ординат y
    in_circle.sort(key=lambda p: p[1])

    print("Точки внутри круга, отсортированные по возрастанию y:")
    if in_circle:
        for x, y in in_circle:
            print(f"({x}; {y})")
    else:
        print("Таких точек нет.")
