#Чтение данных из файла input4.txt
with open('input4.txt', 'r', encoding='utf-8') as f:
    lines = f.read().strip().splitlines()

n = int(lines.strip())
coords = list(map(float, lines.strip().split()))

if len(coords) != 2 * n:
    raise ValueError(f"Ошибка: должно быть введено {2 * n} чисел.")

#Преобразуем плоский список координат в список точек (x, y)
points = [(coords[i], coords[i + 1]) for i in range(0, 2 * n, 2)]

#Максимальное расстояние между соседними точками
max_dist = -1
pair = None

for i in range(n - 1):
    dx = points[i + 1] - points[i]
    dy = points[i + 1] - points[i]
    dist = (dx ** 2 + dy ** 2) ** 0.5
    if dist > max_dist:
        max_dist = dist
        pair = (points[i], points[i + 1])

#Чтение параметров круга
x0 = float(lines.strip())
y0 = float(lines.strip())
r = float(lines.strip())

#Точки, попадающие в круг с центром (x0, y0) и радиусом r
in_circle = [(x, y) for x, y in points if (x - x0) ** 2 + (y - y0) ** 2 <= r ** 2]

#Сортировка точек по возрастанию ординаты y
in_circle.sort(key=lambda p: p)

#Запись результатов в файл output4.txt
with open('output4.txt', 'w', encoding='utf-8') as f:
    f.write(f"Максимальное расстояние между соседними точками: {max_dist}\n")
    f.write(f"Между точками: {pair}\n")
    f.write("Точки внутри круга, отсортированные по возрастанию y:\n")
    if in_circle:
        for x, y in in_circle:
            f.write(f"({x}; {y})\n")
    else:
        f.write("Таких точек нет.\n")
