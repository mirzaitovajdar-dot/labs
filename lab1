import math
#импортирует библиотеку math, которая позволяет использовать математические функции (sin,cos и т.д.)
a = int(input("введите a = "))
#вводим переменную a
z1 = (1 - 2 * math.sin(a)**2) / (2 * (1 / math.tan(math.pi/4 + a)) * math.cos(math.pi/4 - a)**2) + math.exp(a)
#в питоне нету котангенса, так что заменяем его на : 1/math.tan
z2 = 1 + math.exp(a)
print("z1 = "f"{z1:.4f}")
#f"{z1:.4f}" - это означает что для z1 выводится ответ с ограничением в 4 знака после запятой
print("z2 = "f"{z2:.4f}")
#вывод на экраны ответы
