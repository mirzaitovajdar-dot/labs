import math
y = float (input("Введите координаты Y = "))
x = float (input("Введите координаты X = "))
r = 2 * math.cos(2 * x)
#значение функции
if -2 <= x <= 2 and y * (y - r) <= 0:
#попадание если x между -2 и 2, а y если он между 0 и r
    print("Точка попадает в закрашенную область")
else:
    print("Точка не попадает в закрашенную область")
