import random

# Размерность матрицы
rows = 4
cols = 13
total_elements = rows * cols  # 52 элемента

# Генерируем список чисел от 1 до 52 и перемешиваем их
numbers = list(range(1, total_elements + 1))
random.shuffle(numbers)

# Заполняем матрицу: берём числа из перемешанного списка по порядку
matrix = []
index = 0
for _ in range(rows):
    row = numbers[index:index + cols]
    matrix.append(row)
    index += cols

# Вывод матрицы на экран
for row in matrix:
    # Форматируем вывод: каждое число занимает 3 символа для ровного столбца
    print(" ".join(f"{num:3}" for num in row))
