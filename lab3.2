import random
import math

def is_hit(x, y, R):
    #вне круга, но в закрашенной области
    in_square = -R <= x <= R and -R <= y <= R
    outside_circle = x**2 + y**2 > R**2
    
    #внутри круга, но в заштрихованных сегментах
    inside_circle = x**2 + y**2 <= R**2
    segment_1 = y > x + R  # выше хорды от (-R, 0) до (0, R)
    segment_2 = y < -x - R  # ниже хорды от (R, 0) до (0, -R)
    
    return (in_square and outside_circle) or (inside_circle and (segment_1 or segment_2))

#Параметры
R = 1.0  # радиус круга
num_shots = 10

# Генерация выстрелов и проверка попаданий
for i in range(num_shots):
    #Генерируем случайные координаты
    x = random.uniform(-R, R)
    y = random.uniform(-R, R)
    
    if is_hit(x, y, R):
        print(f"Выстрел {i+1}: ({x:.3f}, {y:.3f}) — ПОПАДАНИЕ")
    else:
        print(f"Выстрел {i+1}: ({x:.3f}, {y:.3f}) — ПРОМАХ")
