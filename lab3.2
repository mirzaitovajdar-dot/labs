import random
import math

for i in range(1, 11):
    x = random.uniform(-2, 2)
    y = random.uniform(-2, 2)
    r = 2 * math.cos(2 * x)

    if -2 <= x <= 2 and y * (y - r) <= 0:
        result = "попадание"
    else:
        result = "промах"

    print(f"Выстрел {i:}: x = {x:1.2f}  y = {y:2.2f}  — {result}")
